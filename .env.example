# Copy this file to .env. You only need the key of the provider you'll use;
# you can also set them from the interface (Settings).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Ollama and LM Studio (local) need no key.

# Provider the app starts with: anthropic | openai | gemini | openrouter | deepseek | groq | mistral |
# ollama | lmstudio | custom. It can be changed later in Settings.
INSIGHT_PROVIDER=anthropic

# Default Claude model and initial effort (low | medium | high | xhigh | max).
INSIGHT_MODEL=claude-opus-5
INSIGHT_EFFORT=high

# Base URL used for the links in notifications (alerts and scheduled reports).
# INSIGHT_PUBLIC_URL=http://127.0.0.1:8000

# Lets the AI run Python (pandas/numpy) for advanced statistics.
# WARNING: it runs in a local subprocess WITHOUT isolation. Only enable it with data you trust.
INSIGHT_ENABLE_PYTHON=false
